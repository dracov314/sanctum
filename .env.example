# ── Sanctum configuration ───────────────────────────────────────────────────
# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# Postgres password (any strong string).
POSTGRES_PASSWORD=changeme-postgres

# Signs session cookies. MUST be a long random value.
SECRET_KEY=changeme-run-openssl-rand-hex-32

# Public URL the app is served from (used for redirects / links).
BASE_URL=http://localhost:8080

# Host port the web UI is published on (compose maps this -> container :80).
SANCTUM_PORT=8080

# ── Authentication ──────────────────────────────────────────────────────────
# local | oidc | both
#   local : username/password accounts managed by Sanctum (default)
#   oidc  : an external OpenID Connect provider only (fill the OIDC_* vars)
#   both  : offer both on the login screen
AUTH_MODE=local

# Set false once your accounts exist to close public sign-up. The FIRST
# account created on a fresh instance is always the admin.
ALLOW_REGISTRATION=true

# ── Library ────────────────────────────────────────────────────────────────
# Who can pull a raw book PDF or a whole-system ZIP:
#   admin : admins only (default). Everyone else still reads books in-app.
#   all   : any signed-in user (only for a fully trusted private instance).
LIBRARY_DOWNLOAD_POLICY=admin

# ── Uploads ────────────────────────────────────────────────────────────────
# Per-file ceilings (MiB). First covers campaign files / banners / character
# sheets / wiki-markdown; second covers admin book-PDF uploads.
MAX_UPLOAD_MB=25
MAX_BOOK_UPLOAD_MB=300

# ── OpenID Connect (only needed for AUTH_MODE=oidc or both) ─────────────────
# Any compliant provider. Endpoints are auto-discovered from
# <issuer>/.well-known/openid-configuration — no provider-specific URLs.
# Register a client with redirect URI  <BASE_URL>/api/auth/callback
OIDC_ISSUER=                       # e.g. https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO             # login button reads "Sign in with <this>"
# Optional — grant admin by a `groups` claim value or by email (comma lists).
# With neither set, the first account to sign in becomes the admin.
OIDC_ADMIN_GROUPS=
OIDC_ADMIN_EMAILS=
# For a clean "return to Sanctum after sign-out", also register <BASE_URL> as a
# post-logout / logout redirect URI on your provider. Set to "-" to skip it
# (the user lands on the provider's own logged-out page instead).
OIDC_POST_LOGOUT_REDIRECT=

# ── Discord bot (only used with `--profile bot`) ───────────────────────────
DISCORD_BOT_TOKEN=
BOT_API_KEY=

# ── Service / automation account (optional) ────────────────────────────────
# A machine login for CI, uptime monitoring, or an assistant working on your
# instance. Everything here is off unless BOTH secrets below are set — if you
# don't want any of this, leave them blank and the endpoint doesn't exist.
#
#   Log in:  GET /api/auth/automation/<AUTOMATION_SECRET_KEY>
#            (returns a session cookie; also redirects a browser into the app)
#
# The login only works while the anchor account (a real human user) has had a
# live session in the last ~3 hours — so the window it's usable in tracks
# someone actually being at the keyboard.
AUTOMATION_SECRET_KEY=
AUTOMATION_ACTIVITY_USERNAME=          # an existing username on this instance
# Access level for the account (shows in Admin → Users):
#   user  — normal non-admin (default)
#   admin — instance admin
#   dev   — admin + a diagnostics namespace; reserved for a later release.
#           Setting it now warns and falls back to "user".
AUTOMATION_ACCOUNT_ROLE=user

# ── Authentik-specific (optional) ─────────────────────────────────────────
# Only relevant if your OIDC provider is Authentik. Authentik logs a
# "user_write" event on a rename / password change; point a Notification Rule
# there at  POST /api/auth/authentik-webhook/<AUTHENTIK_WEBHOOK_SECRET>  and
# Sanctum will re-sync that user and end their sessions (a 30-day Sanctum
# session would otherwise sit stale). Needs a view-user-only Authentik API
# token. Blank = disabled. Any other IdP: ignore this block.
AUTHENTIK_WEBHOOK_SECRET=
AUTHENTIK_ADMIN_TOKEN=
AUTHENTIK_BASE_URL=                    # e.g. https://id.example.com
